{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rose.dev/troy/marts/dim_customer",
  "title": "dim_customer",
  "description": "Candidate v2 that only ADDS — additive changes the checker accepts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["customer_key", "tier", "annual_revenue"],
  "properties": {
    "customer_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "tier": {
      "type": "string",
      "enum": ["free", "starter", "professional", "enterprise", "elite"]
    },
    "annual_revenue": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 2000000000000
    },
    "lifetime_value": {
      "type": ["number", "null"],
      "minimum": 0
    }
  }
}
