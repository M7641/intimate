{
  "uid": "web-api-services",
  "title": "Web / API Services",
  "description": "RED metrics for web and API services — Rate, Errors, Duration",
  "tags": ["observability", "api", "web"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(otel_http_server_request_duration_seconds_count, service_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(otel_http_server_request_duration_seconds_count{service_name=~\"$service\"}[5m])) by (service_name)",
          "legendFormat": "{{ service_name }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 2,
      "title": "Error Rate (5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(otel_http_server_request_duration_seconds_count{service_name=~\"$service\", http_status_code=~\"5..\"}[5m])) by (service_name) / sum(rate(otel_http_server_request_duration_seconds_count{service_name=~\"$service\"}[5m])) by (service_name)",
          "legendFormat": "{{ service_name }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Duration p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(otel_http_server_request_duration_seconds_bucket{service_name=~\"$service\"}[5m])) by (le, service_name))",
          "legendFormat": "p50 {{ service_name }}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(otel_http_server_request_duration_seconds_bucket{service_name=~\"$service\"}[5m])) by (le, service_name))",
          "legendFormat": "p95 {{ service_name }}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(otel_http_server_request_duration_seconds_bucket{service_name=~\"$service\"}[5m])) by (le, service_name))",
          "legendFormat": "p99 {{ service_name }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 5 }
        }
      }
    },
    {
      "id": 4,
      "title": "Status Codes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(otel_http_server_request_duration_seconds_count{service_name=~\"$service\"}[5m])) by (http_status_code)",
          "legendFormat": "{{ http_status_code }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "bars", "fillOpacity": 50, "stacking": { "mode": "normal" } }
        }
      }
    },
    {
      "id": 5,
      "title": "Top 10 Slowest Endpoints (p95)",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum(rate(otel_http_server_request_duration_seconds_bucket{service_name=~\"$service\"}[5m])) by (le, http_route, service_name)))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "http_route": "Endpoint",
              "service_name": "Service",
              "Value": "p95 (s)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 6,
      "title": "Recent Traces",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "queryType": "nativeSearch",
          "serviceName": "$service",
          "limit": 20
        }
      ]
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s"
}
