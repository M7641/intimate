import os
import platform
import subprocess
from pathlib import Path
from typing import Annotated

import typer
import uvicorn
from apscheduler.schedulers.background import BackgroundScheduler
from joblib import cpu_count
from ouroboros.service import deploy_service
from pure.logging import NimbusLogger

app = typer.Typer()
logger = NimbusLogger(name=__name__).logger


def background_job():
    print("Running background job...")


@app.command("build")
def build() -> None:
    """
    Build the frontend assets.

    This command does not work if the packages have not been installed.
    This can be resolved by running the 'install' command first.

    Examples:
        uv run {{ webapp_name }} build
    """
    inital_dir = Path.cwd()

    os.chdir(Path(__file__).parents[2] / "frontend")

    subprocess.run(
        ["bun", "install", "--frozen-lockfile"],
        check=True,
    )
    subprocess.run(
        ["mkdir", "-p", "dist"],
        check=True,
    )
    subprocess.run(
        ["bun", "run", "build"],
        check=True,
    )

    os.chdir(inital_dir)


@app.command("install")
def install() -> None:
    """
    Install frontend dependencies.

    Examples:
        uv run {{ webapp_name }} install
    """
    inital_dir = Path.cwd()

    os.chdir(Path(__file__).parents[2] / "frontend")

    subprocess.run(
        ["bun", "install"],
        check=True,
    )
    os.chdir(inital_dir)


@app.command("dev")
def dev() -> None:
    """
    Run the development server with hot reloading.

    Examples:
        uv run {{ webapp_name }} dev
    """
    inital_dir = Path.cwd()

    os.chdir(Path(__file__).parents[2] / "frontend")
    subprocess.run(
        ["bun", "run", "dev"],
        check=True,
    )
    os.chdir(inital_dir)


@app.command("start")
def start(
    prod: Annotated[
        bool,
        typer.Option("--prod", "-p", help="Run in production mode"),
    ] = False,
) -> None:
    """
    Examples:
        uv run {{ webapp_name }} start
    """
    if platform.system().lower() == "darwin":
        use_reloader = True
        log_level = "debug"
    else:
        build()
        use_reloader = False
        log_level = "info"

    # Start background scheduler in main process
    scheduler = BackgroundScheduler()
    scheduler.add_job(
        background_job,
        "cron",
        minute="*/5",
    )
    scheduler.start()

    # Run uvicorn in main process (scheduler runs in background thread)
    try:
        uvicorn.run(
            "{{ webapp_name }}.api.api:app",
            host="0.0.0.0",
            port=8050,
            log_level=log_level,
            reload=use_reloader,
            loop="uvloop",
            http="httptools",
            workers=1 if use_reloader else cpu_count() - 1,
        )
    finally:
        scheduler.shutdown()


@app.command("deploy")
def deploy_app() -> None:
    """
    Deploy Applications

    Examples:
        uv run {{ webapp_name }} deploy
    """

    typer.echo("Image deployed!")
    deploy_service(
        service_name="{{ webapp_name }}",
        service_type="webapp",
        target="dev",
        build_args=[
            {"name": "TARGET_ENV", "value": "dev"},
            {"name": "API_KEY", "value": os.getenv("API_KEY")},
        ],
        build_secrets=["GITHUB_TOKEN"],
        dockerfile_path="Dockerfile.react",
        version="v1",
    )


if __name__ == "__main__":
    app()
