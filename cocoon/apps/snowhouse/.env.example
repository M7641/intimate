# ── Database ──────────────────────────────────────────────────────────
# This app is Snowflake-only; the backend is fixed at compile time (no
# DATA_WAREHOUSE_TYPE). Set the SNOWFLAKE_* vars below.

# Connection pool
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT_SECS=60
DB_IDLE_TIMEOUT_SECS=600
DB_MAX_LIFETIME_SECS=1800

# ── Logging ───────────────────────────────────────────────────────────
# Set to "production" for JSON log output
RUST_ENV=development
# Log level filter (https://docs.rs/tracing-subscriber/latest/tracing_subscriber/filter/struct.EnvFilter.html)
# Include service_kit + database so DB connection/pool logs are visible.
# Use database=debug to also log every SQL statement before execution.
RUST_LOG=snowhouse=info,service_kit=info,database=info,tower_http=info

# ── Reliability ───────────────────────────────────────────────────────
# HTTP request timeouts (seconds). GLOBAL is the outer cap on EVERY route, so it
# also bounds the heavy warehouse routes; keep it >= HEAVY and STATEMENT below.
# All three default to 60 so they agree out of the box.
GLOBAL_TIMEOUT_SECS=60
HEAVY_TIMEOUT_SECS=60

# Server-side DB statement timeout applied to every connector (Postgres/Redshift
# SET statement_timeout, Snowflake SQL API timeout). Cuts a runaway query at the
# database before the HTTP timeout fires.
STATEMENT_TIMEOUT_SECS=60

# Circuit breaker
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN_SECS=30

# Rate limiting (requests per second)
RATE_LIMIT_RPS=100
RATE_LIMIT_HEAVY_RPS=10

# Query result cache (in-memory, TTL). Warehouse data changes slowly, so query
# results are cached to cut load and latency. Set TTL to 0 to disable.
QUERY_CACHE_TTL_SECS=1800
# Memory budget for the cache in MB (bounds by RAM, not entry count) — the knob
# that matters on a small instance. Keep well under the container's memory limit.
QUERY_CACHE_MAX_MB=64

# ── Query-history cache ───────────────────────────────────────────────
# The analytics endpoints read query history EXCLUSIVELY from the cache table
# (no information_schema fallback), so `serve` refuses to start until the table
# exists — create it first with `snowhouse cache init` (then `backfill`).
# The table name is fixed at SANDPIT.SNOWHOUSE_QUERY_HISTORY_CACHE (not
# configurable); the connecting role just needs CREATE TABLE on the `sandpit`
# schema. Managed via
# the `cache` CLI (init / backfill / refresh / status). See README + src/cache/.
#
# Keep the cache warm from inside `serve` (no external scheduler needed). Off by
# default. ⚠️ Single-writer: with several replicas, prefer one external
# `snowhouse cache refresh` job instead of this ticker.
# SNOWHOUSE_CACHE_AUTO_REFRESH=false
# SNOWHOUSE_CACHE_REFRESH_SECS=3600

# ── Security ──────────────────────────────────────────────────────────
# Comma-separated CORS origins (MUST be set in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Snowflake ─────────────────────────────────────────────────────────
# SNOWFLAKE_DATABASE=mydb
#
# Warehouse: snowhouse ALWAYS runs on the smallest warehouse the role can see
# (it only reads metadata / query history, never compute). This is automatic —
# no configuration — and overrides any SNOWFLAKE_WAREHOUSE or Nimbus-connection
# warehouse. See README › Warehouse selection.

# Query tagging — every statement carries a QUERY_TAG for cost attribution in
# QUERY_HISTORY. The source defaults to "snowhouse_application"; set it
# here for local runs, or override the whole JSON tag with SNOWFLAKE_QUERY_TAG.
# SNOWFLAKE_QUERY_TAG_SOURCE=snowhouse_application
# SNOWFLAKE_QUERY_TAG={"nimbus@source":"snowhouse_application","nimbus@owner":"system"}

# Snowflake auth type (default "oauth"):
#   oauth → fetch the OAuth token from the Nimbus connections API (needs API_KEY)
#   env   → read SNOWFLAKE_ACCOUNT + SNOWFLAKE_OAUTH_TOKEN directly (local testing)
# SNOWFLAKE_AUTH_TYPE=oauth
# API_KEY=...                 # required when SNOWFLAKE_AUTH_TYPE=oauth
# SNOWFLAKE_ACCOUNT=xy12345.eu-west-1   # required when SNOWFLAKE_AUTH_TYPE=env
# SNOWFLAKE_OAUTH_TOKEN=...             # required when SNOWFLAKE_AUTH_TYPE=env
