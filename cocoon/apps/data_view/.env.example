# ── Database ──────────────────────────────────────────────────────────
# Backend type: "amazon_redshift", "snowflake"
DATA_WAREHOUSE_TYPE=amazon_redshift

# Connection pool
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT_SECS=30
DB_IDLE_TIMEOUT_SECS=600
DB_MAX_LIFETIME_SECS=1800

# ── Logging ───────────────────────────────────────────────────────────
# Set to "production" for JSON log output
RUST_ENV=development
# Log level filter (https://docs.rs/tracing-subscriber/latest/tracing_subscriber/filter/struct.EnvFilter.html)
RUST_LOG=data_view=info,tower_http=info

# ── Reliability ───────────────────────────────────────────────────────
# Request timeouts
GLOBAL_TIMEOUT_SECS=30
HEAVY_TIMEOUT_SECS=120

# Circuit breaker
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN_SECS=30

# Rate limiting (requests per second)
RATE_LIMIT_RPS=100
RATE_LIMIT_HEAVY_RPS=10

# ── Security ──────────────────────────────────────────────────────────
# Comma-separated CORS origins (MUST be set in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Observability ─────────────────────────────────────────────────────
# Set to enable OpenTelemetry tracing (requires --features otel build)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Warehouse-specific ────────────────────────────────────────────────
# REDSHIFT_DATABASE=mydb
# SNOWFLAKE_DATABASE=mydb
